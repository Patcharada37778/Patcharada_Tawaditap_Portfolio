{
  "services": {
    "server": {
      "root": "server/",
      "framework": "express",
      "entrypoint": "src/index.js"
    },
    "client": {
      "root": "client/",
      "framework": "vite",
      "outputDirectory": "dist",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "server" } },
    { "source": "/(.*)", "destination": { "service": "client" } }
  ]
}
